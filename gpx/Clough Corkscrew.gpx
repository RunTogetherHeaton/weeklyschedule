<gpx creator="StravaGPX" version="1.1" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
 <metadata>
  <name>Clough to Irwell back past Dams Head Lodge </name>
  <desc>Up St Mary's Rd crossing over Bury New Rd (safely). Into the Clough through the flower garden. Continue along the Cliugh with the brook on your right turning left just after Buckley Lane. Follow the path as it bends round right and tun left at the end. Turn right towards the Irwell and follow the path back up running along with the Irwell on your left. You should reach a junction with a sign post with four directions. Turn right until you reach Dams Head Lodge and then right again. Take a left back towards the Clough and run through the Clough back to St. Mary's Park. </desc>
  <author>
   <name>Dale Richards</name>
   <link href="https://www.strava.com/athletes/108724580"/>
  </author>
  <copyright author="OpenStreetMap contributors">
   <year>2020</year>
   <license>https://www.openstreetmap.org/copyright</license>
  </copyright>
  <link href="https://www.strava.com/routes/3538586342590219184"/>
 </metadata>
